  // Add custom color schemes to this array
  "schemes": [],
  // Custom commands. Built-in commands are referenced by their "Terminal.*" id below.
  "actions": [
    {
      "command": {
        "action": "setTabColor",
        "color": "#ffffff"
      },
      "id": "User.SetTabColorWhite"
    },
    {
      "command": "toggleShaderEffects",
      "id": "User.ToggleShaderEffects"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 8
      },
      "id": "User.SwitchToTab8"
    },
    {
      "command": {
        "action": "scrollToMark",
        "direction": "previous"
      },
      "id": "User.ScrollToPreviousMark"
    },
    {
      "command": {
        "action": "scrollToMark",
        "direction": "next"
      },
      "id": "User.ScrollToNextMark"
    }
  ],
  // Overrides of the defaults only (command palette, ctrl+tab, copy/paste and
  // alt+arrow focus are already bound by default). To unbind a key, set "id": null.
  "keybindings": [
    // Settings
    { "id": "Terminal.OpenSettingsFile", "keys": "ctrl+," },
    { "id": "Terminal.ToggleFocusMode", "keys": "alt+f" },
    { "id": "User.SetTabColorWhite", "keys": "ctrl+a" },
    { "id": "User.ToggleShaderEffects", "keys": "ctrl+d" },
    // Tabs general
    { "id": "Terminal.OpenNewTab", "keys": "ctrl+t" },
    { "id": "Terminal.ClosePane", "keys": "ctrl+w" },
    // Tab switches
    { "id": "Terminal.SwitchToTab0", "keys": "ctrl+1" },
    { "id": "Terminal.SwitchToTab1", "keys": "ctrl+2" },
    { "id": "Terminal.SwitchToTab2", "keys": "ctrl+3" },
    { "id": "Terminal.SwitchToTab3", "keys": "ctrl+4" },
    { "id": "Terminal.SwitchToTab4", "keys": "ctrl+5" },
    { "id": "Terminal.SwitchToTab5", "keys": "ctrl+6" },
    { "id": "Terminal.SwitchToTab6", "keys": "ctrl+7" },
    { "id": "Terminal.SwitchToTab7", "keys": "ctrl+8" },
    { "id": "User.SwitchToTab8", "keys": "ctrl+9" },
    // Split in the direction of the arrow
    { "id": "Terminal.SplitPaneUp", "keys": "alt+shift+up" },
    { "id": "Terminal.SplitPaneRight", "keys": "alt+shift+right" },
    { "id": "Terminal.SplitPaneDown", "keys": "alt+shift+down" },
    { "id": "Terminal.SplitPaneLeft", "keys": "alt+shift+left" },
    // Scrollback
    { "id": "Terminal.ScrollDown", "keys": "shift+down" },
    { "id": "Terminal.ScrollDownPage", "keys": "pgdn" },
    { "id": "Terminal.ScrollUp", "keys": "shift+up" },
    { "id": "Terminal.ScrollUpPage", "keys": "pgup" },
    { "id": "User.ScrollToPreviousMark", "keys": "ctrl+up" },
    { "id": "User.ScrollToNextMark", "keys": "ctrl+down" },
    // Resize pane
    { "id": "Terminal.ResizePaneDown", "keys": "ctrl+shift+down" },
    { "id": "Terminal.ResizePaneLeft", "keys": "ctrl+shift+left" },
    { "id": "Terminal.ResizePaneRight", "keys": "ctrl+shift+right" },
    { "id": "Terminal.ResizePaneUp", "keys": "ctrl+shift+up" }
  ]
}
