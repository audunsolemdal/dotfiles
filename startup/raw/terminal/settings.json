{
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
  "initialCols": 128,
  "initialRows": 38,
  // Reopen with the previous window position, size, tabs and panes
  "firstWindowPreference": "persistedLayout",
  "tabSwitcherMode": "mru",
  // Selection
  "copyOnSelect": false,
  "copyFormatting": true,
  // Default delimiters minus "-" and ".", so double-click selects whole
  // resource names, hostnames, file names and IPs
  "wordDelimiters": " /\\()\"',:;<>~!@#$%^&*|+=[]{}~?\u2502",
  "profiles": {
    // Shared by every profile below unless overridden
    "defaults": {
      "backgroundImageOpacity": 0.17,
      "colorScheme": "Campbell",
      "font": {
        "face": "LiterationMono Nerd Font Mono",
        "size": 15
      },
      "padding": "10, 10, 0, 10",
      // Prompts are marked automatically; ctrl+up/down jumps between them
      "showMarksOnScrollbar": true
    },
    "list": [
      {
